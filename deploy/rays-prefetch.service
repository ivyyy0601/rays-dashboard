[Unit]
Description=Rays daily data prefetch (no email)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rays
Group=rays
WorkingDirectory=/opt/rays
Environment=TZ=America/New_York
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/rays/venv/bin/python /opt/rays/run_daily.py --prefetch
TimeoutStartSec=57min
StandardOutput=append:/opt/rays/data/cron.log
StandardError=append:/opt/rays/data/cron.log
