[Unit]
Description=Rays Market Sentiment Dashboard (Streamlit)
After=network.target

[Service]
Type=simple
User=rays
Group=rays
WorkingDirectory=/opt/rays
Environment="PATH=/opt/rays/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="TZ=America/New_York"
ExecStart=/opt/rays/venv/bin/streamlit run dashboard.py --server.port 8501 --server.address 127.0.0.1 --server.headless true --browser.gatherUsageStats false
Restart=always
RestartSec=10
StandardOutput=append:/opt/rays/data/streamlit.log
StandardError=append:/opt/rays/data/streamlit.log

[Install]
WantedBy=multi-user.target
